{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Library": {
    "Observability": {
      "ServiceName": "nestflow-worker",
      "SamplingRatio": 1.0,
      "RedactSensitiveData": true,
      "EnableMetrics": false
    },
    "Logging": {
      "WriteToConsole": true,
      "WriteToOtlp": false
    }
  }
}
