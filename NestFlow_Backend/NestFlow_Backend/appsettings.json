{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Library": {
    "Observability": {
      "ServiceName": "nestflow-api",
      "SamplingRatio": 1.0,
      "IgnoredPaths": [ "/health", "/metrics", "/favicon.ico" ],
      "RedactSensitiveData": true
    },
    "Logging": {
      "WriteToConsole": true,
      "WriteToOtlp": true,
      "UseRequestLogging": true
    },
    "ExceptionHandling": {
      "IncludeExceptionDetails": false
    }
  },
  "ConnectionStrings": {
    "NestFlowDb": ""
  },
  "Encryption": {
    "Key": ""
  },
  "LineLogin": {
    "ChannelId": "",
    "ChannelSecret": "",
    "CallbackUrl": "",
    "FrontendRedirectUrl": "http://localhost:5173/"
  },
  "LineMessaging": {
    "ChannelId": "",
    "ChannelSecret": "",
    "ChannelAccessToken": ""
  },
  "Dify": {
    "BaseUrl": "",
    "AppKey": ""
  },
  "Session": {
    "CookieName": "nestflow_session",
    "LifetimeDays": 30,
    "RequireHttps": true,
    "SlidingRenewThreshold": 0.5
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  }
}
