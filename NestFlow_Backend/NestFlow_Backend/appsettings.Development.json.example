{
  "//": "複製為 appsettings.Development.json 後填入實際值。此檔僅為範本，實際檔案不進版控。",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "NestFlowDb": "Server=localhost,1433;Database=NestFlow;User Id=sa;Password=請填入與 .env 相同的密碼;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "Encryption": {
    "//Key": "AES-256-GCM 主金鑰，Base64 格式且解碼後為 32 bytes。可用 PowerShell 產生：[Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Max 256 }))",
    "Key": "請填入 Base64 格式的 32 bytes 金鑰"
  },
  "LineLogin": {
    "//": "取自 LINE Developers Console 的 LINE Login Channel。留空時 /api/auth/line/login 會回傳提示訊息，可改用開發登入。",
    "ChannelId": "請填入 LINE Login Channel ID",
    "ChannelSecret": "請填入 LINE Login Channel Secret",
    "CallbackUrl": "http://localhost:8080/api/auth/line/callback",
    "FrontendRedirectUrl": "http://localhost:5173/"
  },
  "Session": {
    "//RequireHttps": "本機以 HTTP 測試時設為 false，正式環境必須為 true。",
    "RequireHttps": false
  }
}
