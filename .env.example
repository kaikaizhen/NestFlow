# Docker Compose 機密值範本
# 複製為 .env 後填入實際值，.env 不會進版控。

# SQL Server sa 密碼（需含大小寫、數字與符號，長度 8 以上）
MSSQL_SA_PASSWORD=請填入強密碼

# AES-256-GCM 主金鑰，Base64 格式且解碼後為 32 bytes
# 產生方式（PowerShell）：
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Max 256 }))
ENCRYPTION_KEY=請填入Base64格式的32bytes金鑰

# LINE Login Channel（取自 LINE Developers Console）。留空時可改用開發登入端點。
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=

# LINE Messaging API Channel。留空時 Webhook 停用，改用 /api/dev/line 模擬端點測試。
LINE_MESSAGING_CHANNEL_ID=
LINE_MESSAGING_CHANNEL_SECRET=
LINE_MESSAGING_ACCESS_TOKEN=
