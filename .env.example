# Docker Compose 機密值範本
# 複製為 .env 後填入實際值，.env 不會進版控。

# SQL Server sa 密碼（需含大小寫、數字與符號，長度 8 以上）
MSSQL_SA_PASSWORD=請填入強密碼

# AES-256-GCM 主金鑰，Base64 格式且解碼後為 32 bytes
# 產生方式（PowerShell）：
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Max 256 }))
ENCRYPTION_KEY=請填入Base64格式的32bytes金鑰

# LINE Login Channel（取自 LINE Developers Console）。留空時可改用開發登入端點。
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=

# LINE Messaging API Channel。留空時 Webhook 停用，改用 /api/dev/line 模擬端點測試。
LINE_MESSAGING_CHANNEL_ID=
LINE_MESSAGING_CHANNEL_SECRET=
LINE_MESSAGING_ACCESS_TOKEN=

# Dify Workflow：固定格式解析不出結果時的自然語言後援。留空時直接回覆既有用法提示。
DIFY_BASE_URL=
DIFY_APP_KEY=

# 以下皆為選填，留空時 docker-compose.yml 直接執行、不經反向代理（localhost）。
# 部署在反向代理（例如 NAS 上的 Nginx）後面時才需要填，同一份 docker-compose.yml 即可切換，不需要另外的 compose 檔。
# CORS_ORIGIN_0=https://your-domain:8080
# CORS_ORIGIN_1=
# SESSION_REQUIRE_HTTPS=true
# FORWARDED_HEADERS_ENABLED=true
# API_PORT=8081
# PWA_PORT=5173
# LINE_LOGIN_CALLBACK_URL=https://your-domain:8080/nestflow/backend/api/auth/line/callback
# LINE_LOGIN_FRONTEND_REDIRECT_URL=https://your-domain:8080/nestflow/
# VITE_API_BASE_URL=https://your-domain:8080/nestflow/backend
# VITE_BASE_PATH=/nestflow/

# Observability（選填）。log 不需設定：stdout → Docker → Alloy → Loki。
# trace 以 OTLP HTTP 送 Tempo；與 Tempo 同在 observability 網路時用容器名稱，不要寫 IP。
# ENABLE_OPEN_TELEMETRY=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318
# OTEL_SERVICE_NAME=nestflow-api
# OTEL_WORKER_SERVICE_NAME=nestflow-worker
